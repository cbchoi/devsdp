{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbchoi/devsdp/docs/ses-platform/schema/ses.schema.json",
  "title": "SES canonical representation (draft 0.1)",
  "description": "System Entity Structure의 타입 수준 명세. 가지치기 결정과 모델베이스 바인딩은 별도 스키마로 둔다.",
  "type": "object",
  "required": [
    "ses",
    "name",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "ses": {
      "type": "string",
      "description": "표현 형식 버전",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "name": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/variable"
      }
    },
    "port_types": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/portType"
      }
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "experimental_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "attach_to": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "플러그인 확장용 네임스페이스. 코어는 해석하지 않는다."
    },
    "profile": {
      "$ref": "#/$defs/identifier",
      "description": "이 문서가 따르는 도메인 프로파일의 이름. kind, fields, links의 뜻은 프로파일이 정한다."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_가-힣][A-Za-z0-9_가-힣]*$",
      "description": "영문자, 숫자, 밑줄, 한글 음절. 숫자로 시작하지 않는다."
    },
    "scalarType": {
      "type": "string",
      "enum": [
        "int",
        "float",
        "str",
        "bool",
        "enum"
      ]
    },
    "variable": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/scalarType"
        },
        "default": {},
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "portType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scalarType"
          }
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "type",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "doc": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "description": "필수 포트. 입력 포트이면 들어오는 결합이, 결합 모델의 출력 포트이면 내부에서 나가는 결합이 있어야 한다 (08 문서의 조건 C4)."
        }
      }
    },
    "attribute": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/scalarType"
        },
        "default": {},
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "expr": {
          "$ref": "#/$defs/expression",
          "description": "SES 변수, 등록한 함수, 복제본의 번호에서 정해지는 값. default보다 앞선다. each와 함께 쓸 수 없다."
        },
        "each": {
          "type": "array",
          "description": "복제본마다의 값. multi-aspect의 i번째 복제본(과 그 아래)이 i번째 값을 가진다. 복제본이 아니거나 목록이 모자라면 default를 쓴다."
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "boolean"
        },
        "extends": {
          "$ref": "#/$defs/identifier",
          "description": "전문화 부모 엔티티. 속성과 포트를 상속한다."
        },
        "stereotype": {
          "type": "string",
          "enum": [
            "atomic",
            "coupled",
            "abstract",
            "frame",
            "void"
          ],
          "description": "void는 없음 대안이다. specialization의 대안으로만 쓰이며 선택되면 그 구성요소가 모델에서 빠진다."
        },
        "doc": {
          "type": "string"
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/port"
          }
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        },
        "aspects": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/aspect"
          }
        },
        "multi_aspects": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/multiAspect"
          }
        },
        "specializations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/specialization"
          }
        },
        "metadata": {
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/identifier",
          "description": "도메인 프로파일이 정의한 유형"
        },
        "fields": {
          "type": "object",
          "description": "유형이 정한 필드의 값. 타입과 필수 여부는 프로파일에 있다.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "links": {
          "type": "object",
          "description": "관계 유형에서 대상 엔티티 정의 이름들로. 관계의 뜻과 규칙은 프로파일에 있다.",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "partRef": {
      "description": "부분으로 쓰는 엔티티. 이름만 적거나, 같은 정의를 다른 이름으로 쓸 때 def 와 alias 를 적는다.",
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "object",
          "required": [
            "def"
          ],
          "additionalProperties": false,
          "properties": {
            "def": {
              "$ref": "#/$defs/identifier"
            },
            "alias": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "aspect": {
      "type": "object",
      "required": [
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/partRef"
          }
        },
        "couplings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coupling"
          }
        },
        "priority": {
          "type": "integer",
          "description": "우선순위. 작을수록 우선. 없으면 가장 뒤. 병합으로 형제가 된 분해와, 함께 참인 분해의 규칙을 가른다(18_classic_parity.md 3절)."
        },
        "rule": {
          "$ref": "#/$defs/expression",
          "description": "참일 때 이 aspect가 선택된다."
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "multiAspect": {
      "type": "object",
      "required": [
        "part",
        "cardinality"
      ],
      "additionalProperties": false,
      "properties": {
        "part": {
          "$ref": "#/$defs/partRef"
        },
        "cardinality": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "object",
              "required": [
                "var"
              ],
              "additionalProperties": false,
              "properties": {
                "var": {
                  "$ref": "#/$defs/identifier"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "min"
              ],
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "min 이상이어야 한다. 스키마로는 적지 못하므로 적재기가 검사한다."
                }
              }
            }
          ]
        },
        "naming": {
          "type": "string",
          "pattern": "^[A-Za-z_가-힣{][A-Za-z0-9_가-힣{}]*$",
          "description": "복제본 이름 템플릿. {i}가 번호로, {n}이 개수로, {part}가 부분의 이름으로 치환된다. {i}가 있어야 하고, 치환한 이름은 identifier여야 한다."
        },
        "couplings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "fan_out_fan_in",
                "chain",
                "ring",
                "broadcast",
                "custom"
              ]
            },
            "fan_out": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coupling"
              }
            },
            "fan_in": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coupling"
              }
            },
            "between": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coupling"
              },
              "description": "복제본 사이의 결합. 부분 자리에 {i}와 {next}를 쓰면 i번째에서 i+1번째로(pattern이 ring이면 마지막에서 첫째로도), {i}와 {j}를 쓰면 서로 다른 모든 쌍으로 사례화한다."
            },
            "custom": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coupling"
              }
            },
            "first": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coupling"
              },
              "description": "첫째 복제본에만 적용. 부분 자리에 {part}"
            },
            "last": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coupling"
              },
              "description": "마지막 복제본에만 적용. 부분 자리에 {part}"
            }
          }
        },
        "priority": {
          "type": "integer",
          "description": "우선순위. aspect의 priority와 같다. 작을수록 우선."
        },
        "rule": {
          "$ref": "#/$defs/expression"
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "specialization": {
      "type": "object",
      "required": [
        "alternatives"
      ],
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "select": {
          "$ref": "#/$defs/selectRule"
        },
        "default": {
          "$ref": "#/$defs/identifier"
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "selectRule": {
      "type": "object",
      "required": [
        "when",
        "then"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/expression"
        },
        "then": {
          "$ref": "#/$defs/identifier"
        },
        "else": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "$ref": "#/$defs/selectRule"
            }
          ]
        }
      }
    },
    "coupling": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "port 또는 part.port. 자리표시자 {part}, {i} 허용"
        },
        "to": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "doc": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "require": {
          "$ref": "#/$defs/expression"
        },
        "forbid": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "expression": {
      "description": "작은 선언적 표현식 언어. eval 문자열 대신 구조화된 AST를 쓴다.",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "var"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            }
          },
          "description": "값으로 쓰는 변수. 함수의 인자, 비교의 오른쪽, 속성의 식에 쓴다."
        },
        {
          "required": [
            "var",
            "eq"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "eq": {}
          }
        },
        {
          "required": [
            "var",
            "ne"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "ne": {}
          }
        },
        {
          "required": [
            "var",
            "ge"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "ge": {
              "type": [
                "number",
                "object"
              ]
            }
          }
        },
        {
          "required": [
            "var",
            "gt"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "gt": {
              "type": [
                "number",
                "object"
              ]
            }
          }
        },
        {
          "required": [
            "var",
            "le"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "le": {
              "type": [
                "number",
                "object"
              ]
            }
          }
        },
        {
          "required": [
            "var",
            "lt"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "lt": {
              "type": [
                "number",
                "object"
              ]
            }
          }
        },
        {
          "required": [
            "var",
            "in"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            },
            "in": {
              "type": "array"
            }
          }
        },
        {
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "required": [
            "selected"
          ],
          "additionalProperties": false,
          "properties": {
            "selected": {
              "type": [
                "string",
                "object"
              ],
              "description": "어떤 선택 지점이 그 선택지를 골랐는가. 선택 제약(constraints)에서만 쓴다. 글자로는 '정의/이름=선택지'(specialization의 대안이나 multi-aspect의 개수) 또는 '정의=분해'. 예: Buffer/policySpec=PriorityBuffer. 객체로는 at(정의) 또는 path(구성요소 경로)와, specialization과 alternative, multi_aspect와 count, aspect 가운데 하나."
            }
          }
        },
        {
          "required": [
            "call"
          ],
          "additionalProperties": false,
          "properties": {
            "call": {
              "$ref": "#/$defs/identifier"
            },
            "args": {
              "type": "array"
            },
            "eq": {},
            "ne": {},
            "ge": {},
            "gt": {},
            "le": {},
            "lt": {},
            "in": {
              "type": "array"
            }
          },
          "description": "이름으로 등록된 SES 함수 호출. 함수 본문은 코드(플러그인)에 있고 명세에는 이름만 둔다. 인자는 상수이거나 값으로 쓰는 식이다. 비교 연산자를 함께 적으면 함수의 값을 견준다. 함수는 같은 인자에 늘 같은 값을 내야 한다."
        },
        {
          "required": [
            "replica"
          ],
          "additionalProperties": false,
          "properties": {
            "replica": {
              "enum": [
                "index",
                "count"
              ]
            },
            "up": {
              "type": "integer",
              "minimum": 0
            },
            "eq": {},
            "ne": {},
            "ge": {},
            "gt": {},
            "le": {},
            "lt": {},
            "in": {
              "type": "array"
            }
          },
          "description": "복제본의 번호(index, 0부터)나 그 multi-aspect가 만든 복제본의 수(count). 속성의 식에서만 쓴다. up은 몇 겹 바깥의 복제본인가이고 적지 않으면 0(자신이거나 자신을 담은 가장 가까운 복제본)이다."
        }
      ]
    }
  }
}
