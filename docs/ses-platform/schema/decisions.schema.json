{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbchoi/devsdp/docs/ses-platform/schema/decisions.schema.json",
  "title": "SES 결정 집합 (draft 0.1)",
  "description": "가지치기를 자료로 적은 것. 결정 하나가 가지치기 SES 하나로 번역되고 결정들은 순서와 무관하게 모두 적용된다. 13_editor_data_model.md 참고.",
  "type": "object",
  "required": ["decisions"],
  "additionalProperties": false,
  "properties": {
    "decisions": {"type": "string", "description": "결정 집합 형식 버전"},
    "name": {"type": "string"},
    "target": {"type": "string", "description": "대상 SES 문서의 이름"},
    "variables": {
      "type": "object",
      "description": "변수 이름에서 남길 값으로. 값 하나 또는 값의 목록.",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/scalar"},
          {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}
        ]
      }
    },
    "choose": {"type": "array", "items": {"$ref": "#/$defs/choice"}},
    "set": {
      "type": "array",
      "items": {"$ref": "#/$defs/override"},
      "description": "속성 값의 재정의. 선택이 아니다. 변이를 줄이지 않고, 만들어지는 구성요소의 속성 값을 바꾼다."
    }
  },
  "$defs": {
    "override": {
      "description": "속성 값의 재정의 하나. at은 그 정의가 준 값을 바꾸고(그 정의가 구성원인 모든 구성요소에 미친다), path는 그 구성요소의 값을 바꾼다(구성원들이 준 값보다 앞선다).",
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "value"],
      "properties": {
        "at": {"type": "string", "description": "정의 이름."},
        "path": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "구성요소 경로. 뿌리에서부터 부분 이름들."},
        "attribute": {"type": "string"},
        "value": {"$ref": "#/$defs/scalar"}
      },
      "oneOf": [{"required": ["at"]}, {"required": ["path"]}]
    },
    "scalar": {"type": ["string", "number", "boolean"]},
    "names": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "minItems": 1, "items": {"type": "string"}}
      ]
    },
    "counts": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      ]
    },
    "choice": {
      "description": "선택 지점에 대한 결정 하나. 가리키는 곳(at, path, node) 하나와 내용(aspect, specialization, multi_aspect) 하나를 가진다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {"type": "string", "description": "정의 이름. 그 정의가 출현하는 모든 곳."},
        "path": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "구성요소 경로. 뿌리에서부터 부분 이름들."},
        "node": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "펼친 나무의 엔티티 노드. 기계가 만든다."},
        "aspect": {"$ref": "#/$defs/names", "description": "남길 분해의 이름. aspect 이름 또는 multi-aspect 이름."},
        "specialization": {"type": "string"},
        "alternative": {"$ref": "#/$defs/names", "description": "남길 대안."},
        "multi_aspect": {"type": "string"},
        "count": {"$ref": "#/$defs/counts", "description": "남길 개수."}
      },
      "allOf": [
        {"oneOf": [{"required": ["at"]}, {"required": ["path"]}, {"required": ["node"]}]},
        {
          "oneOf": [
            {
              "required": ["aspect"],
              "not": {"anyOf": [{"required": ["specialization"]}, {"required": ["alternative"]}, {"required": ["multi_aspect"]}, {"required": ["count"]}]}
            },
            {
              "required": ["specialization", "alternative"],
              "not": {"anyOf": [{"required": ["aspect"]}, {"required": ["multi_aspect"]}, {"required": ["count"]}]}
            },
            {
              "required": ["multi_aspect", "count"],
              "not": {"anyOf": [{"required": ["aspect"]}, {"required": ["specialization"]}, {"required": ["alternative"]}]}
            }
          ]
        }
      ]
    }
  }
}
