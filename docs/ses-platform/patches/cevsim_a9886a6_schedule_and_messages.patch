+	// Erase only the item of this executor. Erasing by key removes every item that has the same time.
+	static void erase_item(std::multiset<executor_item>& list, Time t, const IExecutor& who)
+	{
+		auto range = list.equal_range(executor_item(t, who));
+		for (auto it = range.first; it != range.second; ++it)
+		{
+			if (it->p_executor == who)
+			{
+				list.erase(it);
+				return;
+			}
+		}
+	}
